```python
import numpy as np
from sklearn.linear_model import LinearRegression

# Input data: Hours studied
X = np.array([[1], [2], [3], [4], [5]])

# Output data: Exam scores
y = np.array([35, 40, 50, 60, 70])

# Create the linear regression model
model = LinearRegression()

# Train the model
model.fit(X, y)

# Predict the score for 6 hours of study
hours = np.array([[6]])
predicted_score = model.predict(hours)

# Display results
print("Linear Regression Model")
print("-----------------------")
print("Hours Studied:", hours[0][0])
print("Predicted Exam Score:", round(predicted_score[0], 2))
print("Model Coefficient:", round(model.coef_[0], 2))
print("Model Intercept:", round(model.intercept_, 2))
```

% Facts
parent(john, mary).
parent(mary, sam).
parent(john, peter).
parent(peter, alice).

% Rules
grandparent(X, Y) :-
    parent(X, Z),
    parent(Z, Y).

ancestor(X, Y) :-
    parent(X, Y).

ancestor(X, Y) :-
    parent(X, Z),
    ancestor(Z, Y).


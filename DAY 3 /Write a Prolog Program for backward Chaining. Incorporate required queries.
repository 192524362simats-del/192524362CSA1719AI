% Facts
parent(john, mary).
parent(mary, sam).
parent(john, david).
parent(david, peter).

% Rules
grandparent(X, Y) :-
    parent(X, Z),
    parent(Z, Y).

ancestor(X, Y) :-
    parent(X, Y).

ancestor(X, Y) :-
    parent(X, Z),
    ancestor(Z, Y).

% Additional Rule
sibling(X, Y) :-
    parent(Z, X),
    parent(Z, Y),
    X \= Y.

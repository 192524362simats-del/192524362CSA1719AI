% Facts
male(john).
male(peter).
male(david).
male(james).

female(mary).
female(lisa).
female(susan).
female(anna).

% Parent relationships
parent(john, peter).
parent(mary, peter).

parent(john, lisa).
parent(mary, lisa).

parent(peter, david).
parent(susan, david).

parent(peter, anna).
parent(susan, anna).

% Rules
father(X, Y) :-
    male(X),
    parent(X, Y).

mother(X, Y) :-
    female(X),
    parent(X, Y).

sibling(X, Y) :-
    parent(P, X),
    parent(P, Y),
    X \= Y.

brother(X, Y) :-
    male(X),
    sibling(X, Y).

sister(X, Y) :-
    female(X),
    sibling(X, Y).

grandparent(X, Y) :-
    parent(X, Z),
    parent(Z, Y).

% Facts
male(john).
male(peter).
male(alex).
male(robert).

female(mary).
female(lisa).
female(susan).
female(emma).

% Parent relationships
parent(john, peter).
parent(mary, peter).

parent(john, lisa).
parent(mary, lisa).

parent(peter, alex).
parent(susan, alex).

parent(peter, emma).
parent(susan, emma).

% Rules
father(X, Y) :-
    male(X),
    parent(X, Y).

mother(X, Y) :-
    female(X),
    parent(X, Y).

grandparent(X, Y) :-
    parent(X, Z),
    parent(Z, Y).

brother(X, Y) :-
    male(X),
    parent(Z, X),
    parent(Z, Y),
    X \= Y.

sister(X, Y) :-
    female(X),
    parent(Z, X),
    parent(Z, Y),
    X \= Y.

sibling(X, Y) :-
    parent(Z, X),
    parent(Z, Y),
    X \= Y.

% Database containing Name and Date of Birth

person('Kalairajan', date(15, 08, 2005)).
person('Arun', date(10, 05, 2004)).
person('Kumar', date(20, 12, 2003)).
person('Priya', date(25, 03, 2005)).
person('Ravi', date(12, 07, 2004)).

% Rule to display the date of birth of a person
dob(Name, DOB) :-
    person(Name, DOB).

% Rule to display all persons
display :-
    person(Name, DOB),
    write('Name: '), write(Name),
    write(' | DOB: '), write(DOB),
    nl,
    fail.
display.

def print_board(board):
    print()
    print(" " + board[0] + " | " + board[1] + " | " + board[2])
    print("---+---+---")
    print(" " + board[3] + " | " + board[4] + " | " + board[5])
    print("---+---+---")
    print(" " + board[6] + " | " + board[7] + " | " + board[8])
    print()


def check_winner(board):
    winning_positions = [
        (0, 1, 2),
        (3, 4, 5),
        (6, 7, 8),
        (0, 3, 6),
        (1, 4, 7),
        (2, 5, 8),
        (0, 4, 8),
        (2, 4, 6)
    ]

    for a, b, c in winning_positions:
        if board[a] == board[b] == board[c]:
            return True

    return False


def tic_tac_toe():
    board = ["1", "2", "3",
             "4", "5", "6",
             "7", "8", "9"]

    current_player = "X"

    print("===== TIC TAC TOE GAME =====")
    print("Player 1: X")
    print("Player 2: O")
    print("Choose a position from 1 to 9.")

    for turn in range(9):
        print_board(board)

        try:
            position = int(input(f"Player {current_player}, enter position: "))
        except ValueError:
            print("Invalid input! Enter a number from 1 to 9.")
            continue

        if position < 1 or position > 9:
            print("Invalid position! Choose between 1 and 9.")
            continue

        if board[position - 1] in ["X", "O"]:
            print("Position already occupied! Try again.")
            continue

        board[position - 1] = current_player

        if check_winner(board):
            print_board(board)
            print(f"Player {current_player} wins!")
            return

        current_player = "O" if current_player == "X" else "X"

        # Count only valid moves
        if turn < 8 and all(cell in ["X", "O"] for cell in board):
            break

    print_board(board)
    print("It's a draw!")


tic_tac_toe()

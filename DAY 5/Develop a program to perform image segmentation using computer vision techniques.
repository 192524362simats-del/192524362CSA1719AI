# Image Segmentation using OpenCV

import cv2
import numpy as np
import matplotlib.pyplot as plt

# Step 1: Read the input image
image = cv2.imread('image.jpg')

# Check whether image is loaded
if image is None:
    print("Error: Image not found!")
else:
    # Convert BGR to RGB
    image_rgb = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)

    # Step 2: Convert image to grayscale
    gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)

    # Step 3: Apply Gaussian Blur
    blurred = cv2.GaussianBlur(gray, (5, 5), 0)

    # Step 4: Apply Otsu's thresholding
    _, segmented = cv2.threshold(
        blurred, 0, 255,
        cv2.THRESH_BINARY + cv2.THRESH_OTSU
    )

    # Step 5: Apply morphological operation
    kernel = np.ones((5, 5), np.uint8)

    segmented = cv2.morphologyEx(
        segmented,
        cv2.MORPH_OPEN,
        kernel
    )

    # Step 6: Display results
    plt.figure(figsize=(12, 5))

    plt.subplot(1, 3, 1)
    plt.imshow(image_rgb)
    plt.title("Original Image")
    plt.axis("off")

    plt.subplot(1, 3, 2)
    plt.imshow(gray, cmap='gray')
    plt.title("Grayscale Image")
    plt.axis("off")

    plt.subplot(1, 3, 3)
    plt.imshow(segmented, cmap='gray')
    plt.title("Segmented Image")
    plt.axis("off")

    plt.show()

    # Step 7: Save segmented image
    cv2.imwrite('segmented_image.jpg', segmented)

    print("Image segmentation completed successfully!")

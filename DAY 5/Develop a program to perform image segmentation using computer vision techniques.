```python
import cv2
import matplotlib.pyplot as plt

# Step 1: Read the input image
image = cv2.imread("input.jpg")

if image is None:
    print("Error: Image not found. Please check the file path.")
    exit()

# Step 2: Convert BGR image to RGB
image_rgb = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)

# Step 3: Convert image to grayscale
gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)

# Step 4: Apply Gaussian blur
blurred = cv2.GaussianBlur(gray, (5, 5), 0)

# Step 5: Perform binary threshold segmentation
_, segmented = cv2.threshold(
    blurred, 127, 255, cv2.THRESH_BINARY
)

# Step 6: Display the results
plt.figure(figsize=(12, 4))

plt.subplot(1, 3, 1)
plt.imshow(image_rgb)
plt.title("Original Image")
plt.axis("off")

plt.subplot(1, 3, 2)
plt.imshow(gray, cmap="gray")
plt.title("Grayscale Image")
plt.axis("off")

plt.subplot(1, 3, 3)
plt.imshow(segmented, cmap="gray")
plt.title("Segmented Image")
plt.axis("off")

plt.tight_layout()
plt.show()

# Step 7: Save the segmented image
cv2.imwrite("segmented_output.jpg", segmented)

print("Image segmentation completed successfully!")
print("Output saved as segmented_output.jpg")
```

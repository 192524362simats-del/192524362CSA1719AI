# Vacuum Cleaner Problem in Python

def vacuum_cleaner():
    rooms = {
        'A': 'Dirty',
        'B': 'Dirty'
    }

    location = 'A'

    print("Initial State:", rooms)

    while 'Dirty' in rooms.values():
        print("\nVacuum Cleaner is in Room", location)

        if rooms[location] == 'Dirty':
            print("Room", location, "is Dirty. Cleaning...")
            rooms[location] = 'Clean'
            print("Room", location, "is now Clean.")
        else:
            print("Room", location, "is already Clean.")

        if location == 'A':
            location = 'B'
        else:
            location = 'A'

    print("\nFinal State:", rooms)
    print("All rooms are clean!")


vacuum_cleaner()
